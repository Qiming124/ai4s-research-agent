# Docker-oriented defaults — copy to repo root as .env before `docker compose up`
# See docker/README.md for full instructions.

DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-pro
MAX_TOKENS=384000
REASONING_EFFORT=max

# Structured JSON logs in container
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TOKEN_STATS=true

HOST=0.0.0.0
PORT=8000

SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=/app/data/sessions.db

ENABLE_MCP=true
MCP_CONFIG_PATH=/app/mcp_servers.json
MCP_ALLOWED_DIRS=/app/data/mcp_files
MCP_MAX_TOOL_ROUNDS=10
MCP_TOOL_RESULT_MAX_CHARS=8000

ORCHESTRATION_BACKEND=langgraph

ENABLE_RAG=true
RAG_CHROMA_PATH=/app/data/chroma
RAG_EMBEDDING_PROVIDER=chroma_default
RAG_AGENTS=literature,theory
