# DeepSeek API 密钥（必填）
# 获取方式：https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 基础 URL（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型 ID：deepseek-v4-pro（强推理）或 deepseek-v4-flash（高性价比）
MODEL=deepseek-v4-pro

# 最大输出 token 数（V4 最大 384000，thinking max 需要较大预算）
MAX_TOKENS=384000

# 推理强度：high 或 max（max 推理更深、消耗更多 token）
REASONING_EFFORT=max

# 日志级别：INFO 或 DEBUG（DEBUG 会打印请求摘要）
LOG_LEVEL=INFO

# 服务端监听地址
HOST=0.0.0.0
PORT=8000

# 会话存储：sqlite（持久化，默认）或 memory（内存，Phase 1 行为）
SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=./data/sessions.db

# L1 工作记忆：历史截断与可选 LLM 摘要
MAX_HISTORY_MESSAGES=0
ENABLE_HISTORY_SUMMARY=false
HISTORY_SUMMARY_MAX_TOKENS=1024

# MCP 工具层（Phase 2B）
ENABLE_MCP=true
MCP_CONFIG_PATH=./mcp_servers.json
MCP_ALLOWED_DIRS=./data/mcp_files
MCP_MAX_TOOL_ROUNDS=10
# 工具结果写入 LLM 上下文前的最大字符数（超出截断并附摘要提示）
MCP_TOOL_RESULT_MAX_CHARS=8000
# 全局工具白名单：逗号分隔 glob 模式；空=全部工具可用
# 示例：filesystem__*,arxiv__search_papers
MCP_TOOL_WHITELIST=
# 可选 JSON 白名单文件，支持 global 列表与 agents 映射（general/theory/experiment/literature）
# MCP_TOOL_WHITELIST_PATH=./mcp_tool_whitelist.json

# Agent 编排后端：legacy（默认，自研 tool loop）或 langgraph（Phase 3+）
ORCHESTRATION_BACKEND=legacy

# L3 向量记忆 / RAG（Phase 5）
ENABLE_RAG=false
RAG_CHROMA_PATH=./data/chroma
# chroma_default（本地默认，无需额外模型）、sentence_transformers、openai 或 test
RAG_EMBEDDING_PROVIDER=chroma_default
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# OpenAI 兼容 Embedding API；空则使用 DEEPSEEK_BASE_URL
RAG_EMBEDDING_BASE_URL=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVAL_TOP_K=4
# 启用 RAG 检索的 Agent（逗号分隔）
RAG_AGENTS=literature,theory
# 启动时索引 MCP_ALLOWED_DIRS 下的 .md/.txt 文件
RAG_INDEX_MCP_FILES=false
