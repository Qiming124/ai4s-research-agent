{
  "web_search": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.web_search"],
    "env": {
      "TAVILY_API_KEY": "${TAVILY_API_KEY}"
    },
    "enabled": true
  },
  "arxiv": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.arxiv"],
    "enabled": true
  },
  "filesystem": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.filesystem"],
    "env": {
      "MCP_ALLOWED_DIRS": "${MCP_ALLOWED_DIRS}"
    },
    "enabled": true
  },
  "sympy": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.sympy"],
    "enabled": true
  },
  "rag": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.rag"],
    "enabled": true
  },
  "numerical": {
    "command": "python",
    "args": ["-m", "server.mcp.servers.numerical"],
    "enabled": true
  }
}
