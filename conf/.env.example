# DeepSeek API 密钥（必填）
# 获取方式：https://platform.deepseek.com/ → API Keys
DEEPSEEK_API_KEY=sk-your-api-key-here

# DeepSeek API 基础 URL（一般无需修改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型 ID：deepseek-v4-pro（强推理）或 deepseek-v4-flash（高性价比）
MODEL=deepseek-v4-pro

# 最大输出 token 数（V4 最大 384000，thinking max 需要较大预算）
MAX_TOKENS=384000

# 推理强度：high 或 max（max 推理更深、消耗更多 token）
REASONING_EFFORT=max

# 日志级别：INFO 或 DEBUG（DEBUG 会打印请求摘要）
LOG_LEVEL=INFO

# 日志格式：text（开发）或 json（Docker/可观测，含 request_id/session_id 等字段）
LOG_FORMAT=text

# 是否将 LLM token 用量写入 SQLite 聚合表
ENABLE_TOKEN_STATS=true

# 服务端监听地址
HOST=0.0.0.0
PORT=8000

# 会话存储：sqlite（持久化，默认）或 memory（内存，Phase 1 行为）
SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=./data/sessions.db

# L1 工作记忆：历史截断与可选 LLM 摘要
MAX_HISTORY_MESSAGES=0
ENABLE_HISTORY_SUMMARY=false
HISTORY_SUMMARY_MAX_TOKENS=1024

# MCP 工具层（Phase 2B）
ENABLE_MCP=true
MCP_CONFIG_PATH=./conf/mcp_servers.json
MCP_ALLOWED_DIRS=./data/mcp_files:./data/theory
MCP_TOOL_WHITELIST_PATH=./conf/mcp_tool_whitelist.json
MCP_MAX_TOOL_ROUNDS=10
# 工具结果写入 LLM 上下文前的最大字符数（超出截断并附摘要提示）
MCP_TOOL_RESULT_MAX_CHARS=8000
# 全局工具白名单：逗号分隔 glob 模式；空=全部工具可用
# 示例：filesystem__*,arxiv__search_papers
MCP_TOOL_WHITELIST=
# 可选 JSON 白名单文件，支持 global 列表与 agents 映射（general/theory/experiment/literature）
# MCP_TOOL_WHITELIST_PATH=./conf/mcp_tool_whitelist.json

# Agent 编排后端：
#   legacy   — 单 GeneralAgent + 自研 tool loop（默认，不走路由）
#   langgraph — MultiAgent 编排（general/theory/experiment/literature）+ LangGraph 工具循环
#   multi    — 与 langgraph 相同（语义别名，便于理解「多 Agent」）
#
# 推荐演示/生产（多 Agent + MCP + RAG）：
#   ORCHESTRATION_BACKEND=langgraph
#   ENABLE_MCP=true
#   ENABLE_RAG=true
ORCHESTRATION_BACKEND=langgraph

# L3 向量记忆 / RAG（Phase 5）
# legacy 模式下若 RAG_AGENTS 含 general，GeneralAgent 也会注入检索上下文
ENABLE_RAG=true
RAG_CHROMA_PATH=./data/chroma
# chroma_default（本地默认，无需额外模型）、sentence_transformers、openai 或 test
RAG_EMBEDDING_PROVIDER=chroma_default
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
# OpenAI 兼容 Embedding API；空则使用 DEEPSEEK_BASE_URL
RAG_EMBEDDING_BASE_URL=
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_RETRIEVAL_TOP_K=4
# 启用 RAG 检索的 Agent（逗号分隔）；含 general 时 legacy 模式也会检索
RAG_AGENTS=literature,theory,general
# 启动时索引 MCP_ALLOWED_DIRS 下的 .md/.txt 文件（用户删除过的 MCP 文件不会再次自动索引）
RAG_INDEX_MCP_FILES=true

# L4 结构化记忆注入（v0.3）
STRUCTURED_MEMORY_AGENTS=theory

# 意图路由：true 时用 LLM 分类 Agent（失败回退关键词规则）；false 仅规则
ROUTER_USE_LLM=false

# Tavily 搜索（**国内网络推荐必填**）：设置后 web_search MCP 优先使用 Tavily API
# 免费注册：https://tavily.com → 复制 API Key 到下方
# TAVILY_API_KEY=tvly-xxxxxxxx
#
# 未配置时 web_search 会尝试 DuckDuckGo/Wikipedia，国内通常 ConnectTimeout。
# 若有 HTTP 代理，可设置 HTTPS_PROXY 或 WEB_SEARCH_HTTP_PROXY。
