# Docker 默认配置 — 配合 docker/docker-compose.yml 使用
# 复制到 conf/.env 并填入真实密钥；完整说明见 doc/docker.md

DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL=deepseek-v4-pro
MAX_TOKENS=384000
REASONING_EFFORT=max

# 容器内结构化 JSON 日志
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_TOKEN_STATS=true

HOST=0.0.0.0
PORT=8000

SESSION_STORE_BACKEND=sqlite
SESSION_DB_PATH=/repo/data/sessions.db

ENABLE_MCP=true
MCP_CONFIG_PATH=/repo/conf/mcp_servers.json
MCP_TOOL_WHITELIST_PATH=/repo/conf/mcp_tool_whitelist.json
MCP_ALLOWED_DIRS=/repo/data/mcp_files
MCP_MAX_TOOL_ROUNDS=10
MCP_TOOL_RESULT_MAX_CHARS=8000

ORCHESTRATION_BACKEND=langgraph

ENABLE_RAG=true
RAG_CHROMA_PATH=/repo/data/chroma
RAG_EMBEDDING_PROVIDER=chroma_default
RAG_AGENTS=literature,theory
