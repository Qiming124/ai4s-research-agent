#!/usr/bin/env bash
# pre-commit hook：阻止真实 API Key 被提交到仓库。
# 安装方式：bash scripts/git-hooks/install.sh

set -euo pipefail

RED="\033[0;31m"
NC="\033[0m"

exit_code=0

# 检查所有暂存文件中是否包含疑似真实 API Key 的模式
# 模式：sk- 后跟 20 个以上字母数字
PATTERN="sk-[a-zA-Z0-9]\{20,\}"

staged_files=$(git diff --cached --name-only)

found=0
while IFS= read -r file; do
  # 对每个暂存文件搜索模式（只在暂存区中搜索）
  if git diff --cached -- "$file" | grep -q "$PATTERN"; then
    echo -e "${RED}[pre-commit] 发现疑似真实 API Key 在文件: $file${NC}"
    found=1
  fi
done <<< "$staged_files"

if [ "$found" -eq 1 ]; then
  echo ""
  echo -e "${RED}=============================================${NC}"
  echo -e "${RED}  提交被阻止：暂存文件中包含疑似 API Key${NC}"
  echo -e "${RED}=============================================${NC}"
  echo ""
  echo "请确保："
  echo "  1. .env 已在 .gitignore 中（不会被 commit）"
  echo "  2. .env.example 中只使用占位符 sk-your-api-key-here"
  echo "  3. 源码中没有硬编码的真实密钥"
  echo ""
  exit 1
fi

exit 0
