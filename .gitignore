# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# 密钥与本地配置（切勿提交）
conf/.env
.env

# 日志
log/*.log
log/*
!log/.gitkeep

# 测试缓存（tests/ 目录纳入版本库）
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
benchmarks/

# IDE
.vscode/
.idea/
.cursor/

# 系统文件
.DS_Store

# Web 前端
app/web/node_modules/
app/web/dist/
app/web/test-results/

# 运行时数据（种子工作区 data/theory、data/experiments/configs 纳入版本库）
data/chroma/
data/*.db
data/*.pdf
data/*.docx
data/mcp_files/*
!data/mcp_files/.gitkeep
data/experiments/logs/*
!data/experiments/logs/.gitkeep
data/experiments/notebooks/results/
data/experiments/configs/campaign_dynamic_symbolic.yaml
data/experiments/configs/campaign_tmp*.yaml

# API 量化探针原始输出（计划/结果见 doc/API-QUANT-*.md）
data/quant_probe/

# 课题运行时工作区（default 等由 API 创建）
data/projects/*
!data/projects/.gitkeep

# 已废弃：旧 Campaign 运行时目录（若本地残留可整目录删除）
data/campaigns/

# 流水线写出的形式化/反例稿（保留种子 pl-critical-points / relu_saddle）
data/theory/campaigns/*-problem.md
data/theory/campaigns/multi-paper-pipeline-*.md
data/theory/counterexamples/*
!data/theory/counterexamples/relu_saddle.md
!data/theory/counterexamples/.gitkeep

# SkillsBridge / 探索输出
data/explore_outputs/*
!data/explore_outputs/.gitkeep

# 导出 API 写入的 LaTeX（非种子）
data/theory/proofs/export.tex

# 本地导出/字体/冒烟测试产物（勿提交）
data/test_*
data/theory/_smoke.md
data/theory/smoke_test_file.md
app/web/tmp_*.json
app/web/tmp_thm_cases.json

# 导出实验室生成物与 arXiv 参考 PDF（保留 README / FORMAT_NOTES / 文本样例）
data/arxiv_refs/*.pdf
data/export_samples/*.pdf
data/export_samples/*.docx
data/export_test_lab/*/
data/export_test_lab/reports/*.json
!data/export_test_lab/README.md
!data/export_test_lab/reports/
!data/export_test_lab/reports/*.md

# 提交材料包：大字体与压缩包不入库（成片/文档保留）
submission/**/assets/fonts/
submission/*.tar.gz
submission/*.zip

# 本地联测大文件（结构化 JSON 可入库）
test-data/Downloads/
